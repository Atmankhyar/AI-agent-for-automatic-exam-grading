APP_NAME=exam-corrector
API_V1_PREFIX=/api
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Auth ---------------------------------------------------------------
# Generate a real key for anything shared: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ALLOW_TEACHER_SELF_REGISTRATION=true
# Creates demo teacher/student accounts on startup. Local development only.
SEED_DEMO_DATA=true

# --- Database -------------------------------------------------------------
# Local run without Docker: DATABASE_URL=sqlite:///./exam.db (then: alembic upgrade head)
DB_HOST=localhost
DB_PORT=5432
DB_USER=exam
DB_PASSWORD=exam
DB_NAME=exam

# --- Files ----------------------------------------------------------------
FILE_STORAGE_PATH=./storage
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=30

# --- Background grading ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# inline = run in the API process (no Redis needed); celery = Celery worker (docker compose)
GRADING_EXECUTOR=inline

# --- LLM grading (Google Gemini) ---------------------------------------------
LLM_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey. Never commit it.
# Free-tier prompts may be used by Google to improve its products: do not send real student data on it.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
# >1 enables self-consistency sampling (cost x N), used for the uncertainty signal
LLM_SAMPLES=1
GRADING_PROMPT_VERSION=open_v2
REVIEW_SPREAD_THRESHOLD=0.15

# --- Code execution sandbox ---------------------------------------------------
# docker = run student code in locked-down containers (needs a Docker daemon; see docs/SANDBOX_THREAT_MODEL.md)
CODE_SANDBOX=disabled
SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_RUNTIME=runsc
SANDBOX_MEMORY_MB=128
SANDBOX_TEST_TIMEOUT_S=2
SANDBOX_TOTAL_TIMEOUT_S=20
